# Local Development Overrides
# Copy this file to .env.local and customize for your local setup
# .env.local is gitignored and will override values in .env

# Uncomment and modify these as needed for your local development

# Custom ports
# PORT=3001

# Local API endpoints (if running on different ports)
# REACT_APP_API_BASE_URL=http://localhost:8001
# REACT_APP_AUTH_API_URL=http://localhost:8089

# Your personal Mapbox token
# REACT_APP_MAPBOX_ACCESS_TOKEN=your_personal_mapbox_token

# Development preferences
# BROWSER=chrome
# FAST_REFRESH=false
