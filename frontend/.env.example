# React App Configuration
# Port for the React development server
PORT=3000

# API Endpoints
# Main API server (for forecasting, dashboard, routes)
REACT_APP_API_BASE_URL=http://localhost:8000

# Authentication API server
REACT_APP_AUTH_API_URL=http://localhost:8088

# Mapbox Configuration
# Mapbox access token for map functionality (get from https://mapbox.com)
REACT_APP_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Environment
NODE_ENV=development

# Disable automatic browser opening (optional)
BROWSER=none

# Enable source maps for debugging (optional)
GENERATE_SOURCEMAP=true

# JWT Token Configuration
# Token storage key (used by the app)
REACT_APP_TOKEN_STORAGE_KEY=token

# App Configuration
REACT_APP_NAME=AI Stock Predictor
REACT_APP_VERSION=1.0.0

# Development Settings
# Hot reload settings
FAST_REFRESH=true

# Bundle analyzer (set to true to analyze bundle size)
ANALYZE=false
