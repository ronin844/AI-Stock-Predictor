# Production Environment Configuration
# This file is for production deployment

# API Endpoints - Update these for production
REACT_APP_API_BASE_URL=https://your-api-domain.com
REACT_APP_AUTH_API_URL=https://your-auth-api-domain.com

# Mapbox Configuration
REACT_APP_MAPBOX_ACCESS_TOKEN=your_production_mapbox_token

# Environment
NODE_ENV=production

# Disable source maps in production for security
GENERATE_SOURCEMAP=false

# JWT Token Configuration
REACT_APP_TOKEN_STORAGE_KEY=token

# App Configuration
REACT_APP_NAME=AI Stock Predictor
REACT_APP_VERSION=1.0.0

# Production optimizations
INLINE_RUNTIME_CHUNK=false
